# TypeSimulator v2 — Environment Variables Reference
# Copy to .env (or frontend/.env.local) for local overrides. Never commit real .env files.
# NOTE: No secret keys or credentials are used by TypeSimulator. All VITE_* values are public client-side build constants.

# --- Frontend (Vite / Vercel Web Build — public values only) ---
# Runtime mode override: "web" or "desktop" (normally set automatically by npm run build:web / build:desktop)
VITE_RUNTIME_MODE=

# Optional override for the Windows installer download URL (must be https://)
VITE_DOWNLOAD_URL=

# Optional override for the GitHub repository link (must be https://)
VITE_GITHUB_URL=

# --- Desktop Local Development Only (ignored automatically in packaged .exe builds) ---
# Optional Vite dev server URL loaded by PyWebView; restricted strictly to http://127.0.0.1 or http://localhost
TYPESIM_DEV_URL=

# Set to "1" during local source development to enable WebView2 DevTools (always disabled in packaged builds)
TYPESIM_DEBUG=
